	},
	"dependencies": {
		"@connectrpc/connect-web": "catalog:"
	},
	"devDependencies": {
		"@bufbuild/protobuf": "catalog:",
		"@connectrpc/connect": "catalog:",
		"@laurel/rpc": "workspace:*",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
