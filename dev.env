# Shared local-dev environment for every Go service (compose.projects.yml).
# These keys are for local development only and are public; deployed
# environments get real ones from infra (see infra/README.md). A project's
# own .env (from its .env.example) is loaded after this and overrides it.

APP_ENV=development

# User identity tokens: auth signs with IDENTITY_PRIVATE_KEY (services/auth/.env).
IDENTITY_PUBLIC_KEYS=goN5TCoqWCwptJuExIuC/sDzNAunv+Bpuw3fCL1+a2k=

# Other services by compose name. Point one at a shared environment with
# SERVICE_URL_<NAME>=https://... in your project's .env.
UPSTREAM_URL=http://{name}:8080

# Traces: uncomment, `just up jaeger <targets>`, open http://localhost:16686.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
